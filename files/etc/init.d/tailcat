#!/bin/sh /etc/rc.common
# LEDE enables init scripts while assembling rootfs. Keep the generic image disabled.
if [ -n "${IPKG_INSTROOT:-}" ]; then
    enable() { return 0; }
    return 0
fi
START=95
STOP=10
USE_PROCD=1

extra_command "setup" "Create a device identity if missing, enable and start Tailcat"
extra_command "address" "Print the private connection address (keep it secret)"

setup() (
    umask 077
    mkdir -p /var/lock || return 1
    mkdir /var/lock/tailcat-setup 2>/dev/null || {
        echo 'Another Tailcat setup is running.' >&2
        return 1
    }
    stage=
    trap '[ -z "$stage" ] || rm -rf "$stage"; rmdir /var/lock/tailcat-setup' EXIT
    trap 'exit 1' HUP INT TERM
    mkdir -p /etc/tailcat || return 1
    chmod 700 /etc/tailcat || return 1
    if [ ! -e /etc/tailcat/router.private.json ]; then
        stage=$(mktemp -d /etc/tailcat/.setup.XXXXXX) || return 1
        if ! /usr/bin/tailcat genkey --key="$stage/router.private.json" --fixed-region > "$stage/address" 2>/dev/null; then
            rm -rf "$stage"
            echo 'Tailcat key generation failed; check WAN, DNS and system time.' >&2
            return 1
        fi
        if [ ! -s "$stage/router.private.json" ] || ! grep -Eq '^tc[A-Za-z0-9_-]+$' "$stage/address"; then
            rm -rf "$stage"
            echo 'Tailcat returned an invalid identity or connection address.' >&2
            return 1
        fi
        chmod 600 "$stage/router.private.json" "$stage/address"
        # Publish the key first. If interrupted, startup derives the address from it.
        mv "$stage/router.private.json" /etc/tailcat/router.private.json || return 1
        mv "$stage/address" /etc/tailcat/address || return 1
        rmdir "$stage"
    fi
    [ -s /etc/tailcat/router.private.json ] || {
        echo 'Existing Tailcat identity is empty; restore it instead of overwriting it.' >&2
        return 1
    }
    /etc/init.d/tailcat enable && /etc/init.d/tailcat start
)

address() {
    [ -s /etc/tailcat/address ] || {
        echo 'No address yet. Run /etc/init.d/tailcat setup, then retry after it connects.' >&2
        return 1
    }
    cat /etc/tailcat/address
    # Some Tailcat versions write the address without a trailing newline.
    [ "$(tail -c 1 /etc/tailcat/address | wc -l)" -gt 0 ] || printf '\n'
}

start_service() {
    [ -x /usr/bin/tailcat ] && [ -s /etc/tailcat/router.private.json ] || return 1
    umask 077
    chmod 700 /etc/tailcat
    chmod 600 /etc/tailcat/router.private.json
    [ ! -e /etc/tailcat/address ] || chmod 600 /etc/tailcat/address
    procd_open_instance
    procd_set_param command /usr/bin/tailcat serve --key=/etc/tailcat/router.private.json 22,80,9090
    # Persist the address, including recovery when only the private key was restored.
    procd_set_param env TAILCAT_ADDR_FILE=/etc/tailcat/address
    procd_set_param respawn 3600 5 5
    # Startup output contains the address credential; never put it in syslog.
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
